				     <0 144 IRQ_TYPE_LEVEL_HIGH>,
				     <0 147 IRQ_TYPE_LEVEL_HIGH>,
				     <0 150 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_ADC121_CLK>;
