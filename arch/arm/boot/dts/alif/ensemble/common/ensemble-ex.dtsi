#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/pinctrl/alif,ensemble-pinfunc.h>
#include <dt-bindings/clock/alif,ensemble-clock.h>
#include <dt-bindings/gpio/gpio.h>
#include "devkit_ex_dct_defines.h"
/ {
	compatible = "alif,ensemble";
	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,armv8";
			reg = <0>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&L2_0>;
		};

		cpu1: cpu@1 {
			compatible = "arm,armv8";
			reg = <1>;
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			status = "disabled";
		};
	};

	ensemble_cpufreq: cpufreq {
		compatible = "alif,ensemble-cpufreq";
		clock-frequency = <800000000>;  /* 800 MHz boot default */
		status = "disabled";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	mem_stitch: memory1@2000000 {
		device_type = "memory";
		reg = <0x02000000 0x7DD000>;
		status = "disabled";
			/* 0x1000 @ 0x027DD000 reserved for IPC shared memory */
			/* 0x20000 @ 0x027DE000 reserved for arm-tf */
			/* 0x1000 @ 0x027FE000 reserved for MHU services */
	};

	mem_hyperam: memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x4000000>;
		status = "disabled";
			/* 0x1000 @ 0x027DD000 reserved for IPC shared memory */
			/* 0x20000 @ 0x027DE000 reserved for arm-tf */
			/* 0x1000 @ 0x027FE000 reserved for MHU services */
	};

	mem_hyp_stitch: memory2@2000000 {
		device_type = "memory";
		reg = <0x02000000 0x7DD000>,
			<0x20000000 0x4000000>;
		status = "disabled";
			/* 0x1000 @ 0x027DD000 reserved for IPC shared memory */
			/* 0x20000 @ 0x027DE000 reserved for arm-tf */
			/* 0x1000 @ 0x027FE000 reserved for MHU services */
	};

	gic: interrupt-controller@1c000000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg =	<0x1c010000 0x1000>,
			<0x1c02f000 0x2000>,
			<0x1c04f000 0x1000>,
			<0x1c06f000 0x2000>;
		interrupts = <1 9 0xf08>;
	};

	L2_0: l2-cache0 {
		compatible = "cache";
	};

	clocks {
		hfxo: clock-38m4 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <38400000>;
			clock-output-names = "hfxo";
		};

		pll_clk1: clock-800m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <800000000>;
			clock-output-names = "pll_clk1";
		};

		pll_clk3: clock-480m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <480000000>;
			clock-output-names = "pll_clk3";
		};

		ext_clk: clock-20m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <20000000>;
			clock-output-names = "ext_clk";
		};
		wm8904_mclk: clock-12m288 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12288000>;
			clock-output-names = "wm8904_mclk";
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Reserved memory for Ethos-U85 NPU operations - WITHIN HyperRAM */
		ethosu_reserved: ethosu@a2000000 {
			compatible = "shared-dma-pool";
			reg = <0xa2000000 0x1000000>; /* 16MB within HyperRAM */
			no-map;
		};

		/* Ethos-U85 dedicated SRAM pool */
		ethosu_sram: ethosu_sram@a3000000 {
			compatible = "shared-dma-pool";
			reg = <0xa3000000 0x60000>; /* 384KB SRAM within HyperRAM */
			no-map;
		};

		/* CPI frame buffer pool in on-chip SRAM (4 x 560x560 RAW10 frames) */
		cpi_buf: cpi-frame-buffer@2000000 {
			compatible = "shared-dma-pool";
			reg = <0x02000000 0x300000>; /* 3MB from SRAM */
			no-map;
		};

	};

	refclk: timer@1a220000 {
		compatible = "arm,armv7-timer-mem";
		reg = <0x1a220000  0x1000>;
		clock-frequency = <100000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		frame@1a230000 {
			frame-number = <0>;
			interrupts = <0 2 0xf04>;
			reg = <0x1a230000 0x1000>;
		};
	};

	ensemble_reg: regulator@1a609000 {
		compatible = "alif,ensemble-regulator";
		reg = <0x1a609000 0x4>;
		flexio_reg: ensemble_flexio {
			regulator-name = "ensemble_flexio";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-initial-mode = <0x4>;
			regulator-always-on;
		};
	};

	watchdog@1a300000 {
		compatible = "arm,sbsa-gwdt";
		reg = <0x1a300000 0x1000>,
			<0x1a310000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_PCLK>;
		clock-names = "syst_pclk";
		interrupt-parent = <&gic>;
		interrupts = <0 32 4>;
		timeout-sec = <100>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts =	<GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) |
					 IRQ_TYPE_LEVEL_LOW)>,
				<GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(2) |
					 IRQ_TYPE_LEVEL_LOW)>,
				<GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(2) |
					 IRQ_TYPE_LEVEL_LOW)>,
				<GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(2) |
					 IRQ_TYPE_LEVEL_LOW)>;
		arm,cpu-registers-not-fw-configured;
	};

	apb@1a600000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x1a600000 0x00010000>;
		ranges = <>;

		pinmux: pinctrl@1a603000 {
			compatible = "alif,ensemble-pinctrl";
			reg = <0x1a603000 0x00001000>;
		};
	};

	mbox_m55_hp_mhu0_tx: mailbox@1b000000 {
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b000000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 11 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_hp-mhu0_tx";
		status = "disabled";
	};
	mbox_m55_hp_mhu1_tx: mailbox@1b020000 {
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b020000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 46 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_hp-mhu1_tx";
		status = "disabled";
	};
	mbox_m55_hp_mhu0_rx: mailbox@1b010000 {
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b010000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 12 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_hp-mhu0_rx";
		status = "disabled";
	};
	mbox_m55_hp_mhu1_rx: mailbox@1b030000 {
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b030000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 47 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_hp-mhu1_rx";
		status = "disabled";
	};

	mbox_m55_he_mhu0_tx: mailbox@1b040000 {
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b040000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 13 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_he-mhu0_tx";
		status = "disabled";
	};
	mbox_m55_he_mhu1_tx: mailbox@1b060000 {
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b060000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 48 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_he-mhu1_tx";
		status = "disabled";
	};
	mbox_m55_he_mhu0_rx: mailbox@1b050000 {
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b050000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 14 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_he-mhu0_rx";
		status = "disabled";
	};
	mbox_m55_he_mhu1_rx: mailbox@1b070000 {
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b070000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 49 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-m55_he-mhu1_rx";
		status = "disabled";
	};
	mbox_se_mhu0_tx: mailbox@1b800000 {
		#mbox-cells = <2>;
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b800000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 9 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		mbox-name = "arm-se-mhu0_tx";
		status = "disabled";
	};

	mbox_se_mhu1_tx: mailbox@1b820000 {
		compatible = "arm,mhuv2-tx","arm,primecell";
		reg = <0x1b820000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 44 4>;
		interrupt-names = "mhu_tx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-se-mhu1_tx";
		status = "disabled";
	};
	mbox_se_mhu0_rx: mailbox@1b810000 {
		#mbox-cells = <2>;
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b810000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 10 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		mbox-name = "arm-se-mhu0_rx";
		status = "disabled";
	};
	mbox_se_mhu1_rx: mailbox@1b830000 {
		compatible = "arm,mhuv2-rx","arm,primecell";
		reg = <0x1b830000 0x1000>;
		clocks = <&psclks ENSEMBLE_SYST_ACLK>;
		clock-names = "apb_pclk";
		interrupts = <0 45 4>;
		interrupt-names = "mhu_rx";
		arm,mhuv2-protocols = <1 1>, <1 1>;
		#mbox-cells = <2>;
		mbox-name = "arm-se-mhu1_rx";
		status = "disabled";
	};

	client {
		compatible = "arm,client";
		mbox-names = "txdb0", "txdb1",
			     "rxdb0", "rxdb1",
			     "txdb2", "txdb3",
			     "rxdb2", "rxdb3",
			     "txdb4", "txdb5",
			     "rxdb4", "rxdb5";
		mboxes =  <&mbox_m55_hp_mhu0_tx 0 0>,
			  <&mbox_m55_hp_mhu1_tx 0 0>,
			  <&mbox_m55_hp_mhu0_rx 0 0>,
			  <&mbox_m55_hp_mhu1_rx 0 0>,
			  <&mbox_m55_he_mhu0_tx 0 0>,
			  <&mbox_m55_he_mhu1_tx 0 0>,
			  <&mbox_m55_he_mhu0_rx 0 0>,
			  <&mbox_m55_he_mhu1_rx 0 0>,
			  <&mbox_se_mhu0_tx 0 0>,
			  <&mbox_se_mhu1_tx 0 0>,
			  <&mbox_se_mhu0_rx 0 0>,
			  <&mbox_se_mhu1_rx 0 0>;
	};

	rtc: rtc@42000000 {
		compatible = "snps,designware-rtc";
		reg = <0x42000000 0x100>;
		interrupts = <GIC_SPI 339  IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&psclks ENSEMBLE_S32K_CLK>,
			<&psclks ENSEMBLE_SYST_PCLK>;
		clock-names = "timer", "pclk";
	};

	sd_reset: sd-reset {
		compatible = "alif,sd-reset";
		reset-gpios = <&port15 7 GPIO_ACTIVE_HIGH>;
	};

	vbat@42000000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x42000000 0x008000>;
		ranges = <>;

		lpgpio: gpio@42002000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x42002000 0x1000>;

			port16: gpio-port@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-port;
				#gpio-cells = <2>;
				snps,nr-gpios = <8>;
				reg = <0>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 165 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 166 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 167 IRQ_TYPE_LEVEL_HIGH>;
			};
		};
	};

	ahb-b@48100000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x48100000 0x00200000>;
		ranges = <>;

		utimer: timer@48000000 {
			compatible = "alif,alif-utimer";
			clocks = <&psclks ENSEMBLE_SYST_ACLK>;
			clock-names = "axi_clk" ;
			reg = <0x48000000 0x100000>;
			interrupt-parent = <&gic>;
			interrupts =    <GIC_SPI 366 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 367 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 368 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 369 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 370 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 371 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 372 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 373 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 374 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 375 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 377 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 378 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 379 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 380 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 381 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 382 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 383 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 384 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 385 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 386 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 387 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 388 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 389 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 390 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 391 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 392 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 393 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 394 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 395 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 396 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 397 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 398 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 399 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 400 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 401 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 402 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 403 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 404 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 405 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 406 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 407 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 408 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 409 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 410 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 411 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 412 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 413 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 414 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 415 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 416 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 417 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 418 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 419 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 420 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 421 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 422 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 423 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 424 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 425 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 426 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 427 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 428 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 429 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 430 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 431 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 432 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 433 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 434 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 435 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 436 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 437 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 438 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 439 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 440 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 441 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 442 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 443 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 444 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 445 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 446 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 447 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 449 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 450 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 451 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 452 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 453 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 454 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 455 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 456 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 457 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 458 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 459 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 460 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 461 IRQ_TYPE_EDGE_RISING>;
			status = "disabled";
		};

		eth0: ethernet@48100000 {
			compatible = "snps,dwc-qos-ethernet-4.10";
			reg = <0x48100000 0x2000>;
			clock-names = "phy_ref_clk", "apb_pclk", "ptp_ref";
			clocks = <&psclks ENSEMBLE_ETH_CLK>,
				 <&psclks ENSEMBLE_ETH_CSR_CLK>,
				 <&psclks ENSEMBLE_100M_CLK>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>;
			max-speed = <100>;
			phy-handle = <&phy2>;
			phy-mode = "rmii";
			mac-address = [92 60 04 02 c3 e6];
			snps,force_thresh_dma_mode;
			status = "disabled";
			mdio{
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				phy2: phy@0{
					compatible = "ethernet-phy-ieee802.3-c22";
					device_type = "ethernet-phy";
					reg = <0x1>;
				};
			};
		};

		adc_dac6: analog@4902a000 {
			compatible = "alif,adc-dac6";
			reg = <0x4902a000 0x2000>;
		};

		sdmmc: mmc@48102000 {
			compatible = "alif,ensemble-dwcmshc", "snps,dwcmshc-sdhci";
			reg = <0x48102000 0x1000>;
			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_SYST_HCLK>,
				 <&psclks ENSEMBLE_100M_CLK>;
			clock-names = "core", "bus";
			bus-width = <4>;
			max-frequency = <25000000>;
			no-hispeed;
			no-1-8-v;
			status = "disabled";
		};

		spi0: spi@48103000 {
			compatible = "snps,dwc-ssi-1.01a";
			reg = <0x48103000 0x1000>;
			num-cs = <1>;
			interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_SPI0_SS_IN_VAL_MST_CLK>;
			clock-names = "ssi_clk" ;
			reg-io-width = <4>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <1>;
			status = "disabled";
		};

		spi1: spi@48104000 {
			compatible = "snps,dwc-ssi-1.01a";
			reg = <0x48104000 0x1000>;
			num-cs = <1>;
			interrupts = <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_SPI1_SS_IN_VAL_MST_CLK>;
			clock-names = "ssi_clk" ;
			reg-io-width = <4>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <1>;
			status = "disabled";
		};

		spi2: spi@48105000 {
			compatible = "snps,dwc-ssi-1.01a";
			reg = <0x48105000 0x1000>;
			num-cs = <1>;
			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_SPI2_SS_IN_VAL_MST_CLK>;
			clock-names = "ssi_clk" ;
			reg-io-width = <4>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <1>;
			status = "disabled";
		};

		spi3: spi@48106000 {
			compatible = "snps,dwc-ssi-1.01a";
			reg = <0x48106000 0x1000>;
			interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&psclks ENSEMBLE_SPI3_SS_IN_VAL_MST_CLK>;
			clock-names = "ssi_clk" ;
			num-cs = <1>;
			reg-io-width = <4>;
			spi-tx-bus-width = <1>;
			spi-rx-bus-width = <1>;
			spi-max-frequency= <1000000>;
			status = "disabled";
		};

		crc: crc@48107000 {
			compatible = "alif,alif-crccode";
			reg = <0x48107000 0x1000>;
			clocks = <&psclks ENSEMBLE_SYST_HCLK>;
			clock-names = "ahb_clk";
		};

		hsusb: dwc3@48200000 {
			compatible = "alif,ensemble-usb3";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x48200000 0x48200000 0x100000>;
			clock-names = "usb_clk", "dwc_clk";
			clocks = <&psclks ENSEMBLE_USB_CLK>,
				<&psclks ENSEMBLE_DWC_USB_CLK>;
			status = "disabled";
			dwc3: usb@48200000 {
				compatible = "snps","snps,dwc3";
				reg = <0x48200000 0x100000>;
				interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
				phy = <&psclks ENSEMBLE_USB_CLK>;
				phy-names = "usb2_phy";
				dr_mode = "peripheral";
				snps,hsphy_interface = "utmi";
				phy_type = "utmi_wide";
				maximum-speed = "high-speed";
				snps,dis_u3_susphy_quirk;
				snps,dis_u2_susphy_quirk;
				snps,incr-burst-type-adjustment = <1>, <4>, <8>, <16>;
				snps,quirk-frame-length-adjustment = <0x20>;
				snps,usb2-lpm-disable;
				status = "disabled";
			};
		};
	};

