config DRM_D2D
	tristate "DRM Support for TES D/AVE-2D for Alif Ensemble SoC."
	depends on DRM && OF
	depends on ARM
	depends on ARCH_ENSEMBLE || COMPILE_TEST
	select DRM_GEM_DMA_HELPER
	help
	  Render-only DRM driver for the TES D/AVE-2D 2D GPU on Alif
	  Ensemble SoCs. Provides GEM DMA buffer objects and register
	  access ioctls for userspace 2D acceleration.

	  If M is selected the module will be called alif_drm.
